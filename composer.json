{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "spanu18/laravel-pay",
    "description": "Multi-gateway payment processing for Laravel — Stripe, SumUp, Adyen, PayPal, Mollie, Klarna and more.",
    "keywords": [
        "laravel",
        "laravel-pay",
        "payments",
        "payment-gateway",
        "stripe",
        "sumup",
        "adyen",
        "paypal"
    ],
    "homepage": "https://github.com/Spanu18/laravel-pay",
    "license": "MIT",
    "authors": [
        {
            "name": "Spanu18",
            "email": "alessio.spanu03@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "psr/log": "^2.0|^3.0",
        "stripe/stripe-php": "v19.3.0",
        "sumup/sumup-php": "^0.1.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "LaravelPay\\LaravelPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelPay\\LaravelPay\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=90"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelPay\\LaravelPay\\LaravelPayServiceProvider"
            ],
            "aliases": {
                "LaravelPay": "LaravelPay\\LaravelPay\\Facades\\LaravelPay"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
